<main class="profile">
  <div class="profile__back">
    <a href="/static/profile.html" class="profile__back-btn" aria-label="Назад">←</a>
  </div>
  <section class="profile__main">
    <h1 class="profile__name">Изменить пароль</h1>
    <div class="profile__avatar profile__avatar--icon" aria-hidden="true">🔒</div>
    <form id="password-form" method="post" aria-label="Изменить пароль" novalidate>
      <div class="profile__form-row">
        <label for="old_password">Старый пароль</label>
        <input id="old_password" name="old_password" type="password" autocomplete="current-password" />
      </div>
      <span class="field__error" id="err-old_password" role="alert"></span>
      <div class="profile__form-row">
        <label for="new_password">Новый пароль</label>
        <input id="new_password" name="new_password" type="password" autocomplete="new-password" />
      </div>
      <span class="field__error" id="err-new_password" role="alert"></span>
      <div class="field__error field__error--form" id="form-error" role="alert"></div>
      <div id="form-success" class="form-success" role="status"></div>
      <div class="profile__submit-wrap">
        <button class="btn" type="submit">Сохранить</button>
      </div>
    </form>
  </section>
</main>
