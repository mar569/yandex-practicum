<div class="field">
  <label class="field__label" for="f-{{name}}">{{label}}</label>
  <input
    class="field__input"
    id="f-{{name}}"
    name="{{name}}"
    type="{{type}}"
    value="{{defaultValue}}"
    autocomplete="off"
  />
  <span class="field__error" id="err-{{name}}" role="alert"></span>
</div>
